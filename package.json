{
  "name": "awcell",
  "productName": "awCELL",
  "desktopName": "awcell",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "description": "awCELL — elektronik tablo uygulaması",
  "author": "mADEMatik <ademvarol@madematik.com>",
  "license": "MIT",
  "homepage": "https://www.madematik.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/200709078/awCELL.git"
  },
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "deploy": "npm run build && node scripts/deploy-ftp.mjs",
    "electron": "npm run build && node scripts/start-electron.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:win": "npm run build && electron-builder --win nsis",
    "icons": "bash scripts/icons.sh",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "android:aab": "npm run android:sync && cd android && ./gradlew bundleRelease",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "play:gorseller": "npm run build && node scripts/play/gorseller.mjs"
  },
  "build": {
    "appId": "com.madematik.awcell",
    "productName": "awCELL",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "${productName}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "Office;Spreadsheet;Education",
      "executableName": "awcell",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "awCELL",
          "Comment": "Elektronik tablo"
        }
      },
      "fileAssociations": [
        {
          "ext": "awc",
          "name": "awCELL.Workbook",
          "description": "awCELL tablosu",
          "mimeType": "application/x-awcell",
          "role": "Editor"
        }
      ],
      "mimeTypes": [
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "application/vnd.oasis.opendocument.spreadsheet",
        "text/csv"
      ]
    },
    "deb": {
      "packageCategory": "education"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "fileAssociations": [
        {
          "ext": "awc",
          "name": "awCELL.Workbook",
          "description": "awCELL tablosu",
          "mimeType": "application/x-awcell",
          "role": "Editor"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "awCELL"
    }
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "basic-ftp": "^6.2.3",
    "chart.js": "4.5.1",
    "dotenv": "^17.4.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.64.1",
    "vite": "^8.3.4"
  }
}
